# .env.example
# ==========================================
# KIERIVO - KONFIGURACJA ŚRODOWISKA
# ==========================================
# Instrukcja krok po kroku: docs/BACKEND-ROADMAP.md
# Konta, klucze i formalności: docs/SETUP.md

# ==========================================
# 1. TRYB PRACY BACKENDU
# ==========================================
# local — bez bazy i bez kont; dane zostają w przeglądarce (domyślnie)
# cloud — konta, trwałe dane i limity liczone po stronie serwera
#
# W trybie cloud zmienne SUPABASE_* przestają być opcjonalne i serwer
# nie wystartuje bez nich. To celowe: brak konfiguracji ma być widoczny
# dla operatora przy starcie, a nie ujawniać się użytkownikowi przy
# pierwszej próbie logowania.
BACKEND_MODE=local

# ==========================================
# 2. API AI
# ==========================================
# Domyślnie serwer używa Gemini i wymaga wtedy GEMINI_API_KEY. Przy
# AI_PROVIDER=ollama klucz Gemini nie jest wymagany; Ollama działa lokalnie
# lub pod adresem podanym jawnie w OLLAMA_BASE_URL.
AI_PROVIDER=gemini
# Uwaga: subskrypcja "Google AI Pro" NIE obejmuje Gemini API. Potrzebny jest
# osobny projekt Google Cloud z płatnym rozliczaniem. Szczegóły: docs/SETUP.md
GEMINI_API_KEY=twoj_klucz_gemini
# Najtańszy model zdolny do ekstrakcji danych z ogłoszeń.
GEMINI_MODEL=gemini-2.5-flash-lite

# Opcjonalna lokalna Ollama. Domyślne 127.0.0.1 jest bezpieczne dla jednego
# komputera; adres LAN ustaw wyłącznie w prywatnym środowisku operatora.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen-chat:latest

# ==========================================
# 3. SERWER
# ==========================================
PORT=3000
NODE_ENV=development

# Adres publiczny aplikacji. Służy do zbudowania adresów powrotu ze Stripe'a.
APP_URL=http://localhost:3000

# Lista pochodzeń (rozdzielona przecinkami), które mogą wołać API cross-origin.
# Pusta = tylko to samo pochodzenie. NIGDY nie używamy tu gwiazdki.
# Przy wdrożeniu jednokontenerowym (front i API pod jednym adresem) zostaje pusta.
ALLOWED_ORIGINS=

# Ustaw na true WYŁĄCZNIE gdy aplikacja stoi za reverse proxy — na Cloud Run tak.
# Włączone bez proxy pozwala podszyć się przez X-Forwarded-For i ominąć limiter;
# wyłączone za proxy wrzuca wszystkich użytkowników do jednego kubełka.
TRUST_PROXY=false

# ==========================================
# 4. SUPABASE (wymagane przy BACKEND_MODE=cloud)
# ==========================================
# Wartości lokalne wypisuje `supabase start`.
SUPABASE_URL=http://127.0.0.1:54321

# ⚠️ Klucz service_role OMIJA WSZYSTKIE POLITYKI RLS.
# Nigdy z prefiksem VITE_, nigdy w repozytorium, nigdy w zmiennych Vercela.
# Na produkcji trzymany w Secret Managerze, nie w --set-env-vars.
# Klucz anon po stronie serwera — czyta go wyłącznie `npm run test:rls`,
# żeby zalogować testowego użytkownika i sprawdzić, że nie widzi cudzych
# danych. Serwer aplikacji go nie potrzebuje: rozmawia kluczem service_role.
SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=

# Poniższe trafiają do pakietu przeglądarki i są publiczne z definicji.
# Klucz anon chroni RLS, a nie utajnienie.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# ==========================================
# 5. PŁATNOŚCI STRIPE
# ==========================================
# Klucz publikowalny trafia do przeglądarki (prefiks VITE_).
# Uwaga na nazwę: kod czytał kiedyś VITE_STRIPE_PUB_KEY, przez co klucz nigdy
# się nie wczytywał. Obowiązuje wyłącznie nazwa poniżej.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_twoj_klucz

# Opcjonalny publiczny DSN Sentry do raportowania błędów klienta (np. awarii chunków).
# Nie umieszczaj tu auth tokenu Sentry ani żadnego prywatnego klucza.
VITE_SENTRY_DSN=

# Poniższe są WYŁĄCZNIE serwerowe - nigdy nie dodawaj im prefiksu VITE_.
# Bez STRIPE_WEBHOOK_SECRET płatności zostają wyłączone: da się wtedy przyjąć
# płatność i nie da się jej potwierdzić, czyli użytkownik płaci i nie dostaje
# dostępu.
STRIPE_SECRET_KEY=sk_test_twoj_klucz
STRIPE_WEBHOOK_SECRET=whsec_twoj_sekret_webhooka

# ==========================================
# 6. POWIADOMIENIA PUSH (jeszcze nieużywane)
# ==========================================
# Klucz publiczny VAPID identyfikuje serwer nadający wobec serwisu push.
# Jest publiczny z definicji — trafia do pakietu przeglądarki i jest przekazywany
# serwisowi push jako `applicationServerKey`, więc prefiks VITE_ jest tu poprawny,
# a trzymanie wartości w repozytorium nie jest wyciekiem.
#
# Żaden kod jeszcze go nie czyta. Push wymaga serwera, który wyśle powiadomienie,
# a pod obecnym adresem stoi sam frontend. Szczegóły i lista brakujących elementów:
# docs/BACKEND-ROADMAP.md, dodatek „Powiadomienia push".
VITE_VAPID_PUBLIC_KEY=BOWpGAdKYSU_fBqSNhpBh-4HquX7_Fpa8HQQMoqKKvOLuYG0qqZ6OIhXOGqxkmn534KAXEXS9LBy6A105TxeNZE

# ⚠️ Połówka prywatna podpisuje token JWT przy każdym wysłanym powiadomieniu.
# NIGDY z prefiksem VITE_, nigdy w repozytorium — na produkcji w Secret Managerze,
# na tych samych zasadach co STRIPE_SECRET_KEY i service_role.
VAPID_PRIVATE_KEY=

# Adres kontaktowy wymagany przez specyfikację VAPID — trafia do pola `sub`
# tokenu i służy operatorowi serwisu push do kontaktu przy nadużyciach.
VAPID_SUBJECT=mailto:kontakt@twojadomena.pl

# ==========================================
# 7. FRONTEND
# ==========================================
# Adres API. Pusty przy wdrożeniu jednokontenerowym i to jest poprawne —
# front i API są pod tym samym adresem, więc ścieżki względne trafiają gdzie
# trzeba. Wypełnij tylko przy rozdzieleniu hostingu.
VITE_API_URL=
