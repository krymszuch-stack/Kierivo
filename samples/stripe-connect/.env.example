# =============================================================================
# Przykładowa integracja Stripe Connect — zmienne środowiskowe
# =============================================================================
# Skopiuj ten plik do `.env` w tym samym katalogu i uzupełnij wartości.
#
#     cp .env.example .env
#
# `.env` jest w `.gitignore` katalogu głównego i **nigdy** nie trafia do repo.
# Klucz `sk_...` daje pełny dostęp do konta Stripe — traktuj go jak hasło.

# -----------------------------------------------------------------------------
# WYMAGANE — klucz tajny platformy (tryb testowy)
# -----------------------------------------------------------------------------
# UZUPEŁNIJ: Dashboard Stripe → Developers → API keys → "Secret key".
# W trybie testowym zaczyna się od `sk_test_`. Nie używaj tu klucza `sk_live_`:
# ta próbka tworzy prawdziwe konta i prawdziwe płatności.
STRIPE_SECRET_KEY=sk_test_UZUPELNIJ

# -----------------------------------------------------------------------------
# WYMAGANE do obsługi webhooków (reszta próbki działa bez tego)
# -----------------------------------------------------------------------------
# UZUPEŁNIJ: wypisuje go `stripe listen` przy starcie (linia "webhook signing
# secret"). Zaczyna się od `whsec_`. Komenda do lokalnego nasłuchu jest
# w README, sekcja "Webhooki".
STRIPE_WEBHOOK_SECRET=whsec_UZUPELNIJ

# -----------------------------------------------------------------------------
# OPCJONALNE — mają sensowne wartości domyślne
# -----------------------------------------------------------------------------

# Port lokalnego serwera próbki.
PORT=4242

# Adres publiczny próbki. Stripe wraca pod ten adres po onboardingu i po
# zapłacie, więc musi być osiągalny z przeglądarki użytkownika. Przy pracy
# lokalnej zostaw localhost.
SAMPLE_BASE_URL=http://localhost:4242

# Prowizja platformy w procentach ceny produktu (0–100). Trafia do
# `application_fee_amount` przy płatności typu destination charge.
PLATFORM_FEE_PERCENT=10

# Kraj zakładanych kont połączonych (ISO 3166-1 alpha-2, małymi literami).
# Musi być obsługiwany przez kraj Twojej platformy Stripe.
CONNECTED_ACCOUNT_COUNTRY=us

# Waluta cen tworzonych produktów (ISO 4217, małymi literami).
DEFAULT_CURRENCY=usd
