# Dependencies
node_modules/

# Production build outputs
dist/
build/
coverage/

# Environment files and secrets
.env
.env.local
.env.development.local
.env.production.local
!.env.example

# Temporary test files
test_files/

# OS metadata
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Lokalny magazyn zgłoszeń błędów klienta (BACKEND_MODE=local) — dane operacyjne
# serwera, odtwarzane w miarę napływu zgłoszeń; nie należą do historii repo.
logs/

# IDE & Tooling caches
.antigravity/
.gemini/
.idea/
.firebase/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Bazy SQLite narzędzia semantic-work-graph. Plik binarny odtwarzany przez
# `npm run seed:import` — trzymanie go w historii puchnie repozytorium i przy
# każdej zmianie daje konflikt, którego nie da się rozwiązać.
*.db
*.db-journal
*.db-wal
*.db-shm

# Zbiory źródłowe leksykonu pobierane przez `npm run seed:lexicon`
# (PoliMorf ~47 MB + eksport ESCO). Odtwarzalne komendą, więc nie trzymamy
# ich w historii repozytorium.
semantic-work-graph/data/seed/*.gz
semantic-work-graph/data/seed/*.tab
semantic-work-graph/data/seed/esco-skills.pl.csv
semantic-work-graph/data/seed/esco-taxonomy.pl.csv

# Jeden menedżer pakietów. CI, Dockerfile i README używają npm; drugi lockfile
# obok oznacza dwa różne drzewa zależności zależnie od tego, kto co uruchomił.
bun.lock
yarn.lock
pnpm-lock.yaml

# Magazyn próbki Stripe Connect — mapowanie sprzedawców na konta połączone.
# Powstaje przy pierwszym utworzeniu konta i zawiera identyfikatory kont
# z konta Stripe osoby uruchamiającej próbkę, więc nie należy do repozytorium.
samples/stripe-connect/.dane/
