# Wszystko poniżej jest albo odtwarzane w obrazie, albo nie ma prawa do niego trafić.
# Bez tego pliku `gcloud builds submit` wysyła do chmury kilkaset MB node_modules.

node_modules
dist
.git
.github
.firebase
.vscode
.claude

# Sekrety — .env NIGDY nie wchodzi do obrazu. Konfiguracja przychodzi ze zmiennych
# środowiskowych i Secret Managera w czasie uruchomienia usługi.
.env
.env.*
!.env.example

*.log
coverage
semantic-work-graph

# Graf semantyczny jest wykluczony w całości (node_modules podpakietu), ale
# baza do odczytu w kontenerze musi wejsc do kontekstu builda — patrz
# Dockerfile, etap runtime. Lokalne bazy testowe i pliki WAL nie maja tam
# prawa wjsc.
!semantic-work-graph/data
semantic-work-graph/data/test_*.db*

# Pakiet labs/semantic-work-graph: wyklucz node_modules, dist i bazy testowe.
# Sam katalog data/ jest potrzebny do COPY w Dockerfile (etap runtime).
labs/semantic-work-graph/node_modules
labs/semantic-work-graph/dist
labs/semantic-work-graph/data/test_*.db*
labs/semantic-work-graph/data/*.db-wal
labs/semantic-work-graph/data/*.db-shm
