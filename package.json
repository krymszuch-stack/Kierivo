{
  "name": "cvelocity",
  "private": true,
  "version": "0.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:dev": "vite build --mode development",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node22 --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "node --enable-source-maps dist/server.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e-doradca.mjs",
    "test:rls": "node scripts/test-rls.mjs",
    "test:auth-lifecycle": "node scripts/test-auth-lifecycle.mjs",
    "audit:d09:calibrate": "tsx scripts/d09-calibration-report.ts",
    "bledy": "tsx scripts/bledy-klienta.ts",
    "bledy:lista": "tsx scripts/bledy-klienta.ts lista",
    "bledy:czysc": "tsx scripts/bledy-klienta.ts czysc",
    "bledy:bramka": "tsx scripts/bledy-klienta.ts bramka",
    "bledy:linear": "tsx scripts/bledy-klienta.ts linear",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@sentry/react": "^10.71.0",
    "@supabase/supabase-js": "^2.112.3",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "openai": "^7.15.0",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@types/express": "^4.17.21",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "docx": "^9.7.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.1.200",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
